# Provable Resilience Intelligence — .gitignore
# Merged: project-specific rules + GitHub Python template (2026-10-22)

# Python byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# DAB artifacts
.databricks/
bundle/.databricks/

# Superseded bundle files (DAB root moved to project root)
bundle/databricks.yml
bundle/resources/resilience_dashboard.dashboard.yml
bundle/dashboards/.gitkeep
bundle/dashboards/resilience_scorecard.lvdash.json

# OS
.DS_Store
Thumbs.db

# Secrets — never commit
*.pem
*.key
.env
.env.*

# Jupyter
.ipynb_checkpoints/

# Data artifacts (use UC Volumes instead)
data/*.parquet
data/*.csv
data/*.json
!data/.gitkeep

# MLflow artifacts
mlruns/
mlartifacts/

# MLflow model registration markers (0-byte workspace refs)
optical_anomaly_detection
resilience_agent_evaluation
span_risk_classification
ml_score_recalibration

# Logs
*.log
logs/

# Test / coverage artifacts
.pytest_cache/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
*.lcov
.hypothesis/
cover/

# Node.js (React app local builds)
node_modules/
package-lock.json
yarn.lock

# Bundle deployment state
bundle/.bundle/
.bundle/

# Spark checksum files
*.crc

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Cython debug symbols
cython_debug/

# Linters
.ruff_cache/

# PyPI configuration
.pypirc

# Translations
*.mo
*.pot

# Sphinx documentation
docs/_build/

# Streamlit
.streamlit/secrets.toml

